{
  "manifest_version": 3,
  "name": "WebOn",
  "description": "Capture selected text, page context, and screenshots into WebOn's local task list.",
  "version": "1.0.0",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open WebOn",
    "default_popup": "popup.html"
  },
  "options_page": "app.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
